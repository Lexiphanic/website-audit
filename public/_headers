# Cloudflare Workers static-asset headers.
# These apply only to files in public/ served by the ASSETS binding. Responses
# rendered by the Worker get their headers from src/middleware.ts.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), geolocation=(), microphone=()
  X-Frame-Options: DENY
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload

# Hashed build assets never change
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Self-hosted fonts
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Icons and app manifests
/icons/*
  Cache-Control: public, max-age=604800

# Social preview
/social-card.png
  Cache-Control: public, max-age=604800

# Text files that can change
/robots.txt
  Cache-Control: public, max-age=3600
/llms.txt
  Cache-Control: public, max-age=3600
/sitemap.xml
  Cache-Control: public, max-age=3600
