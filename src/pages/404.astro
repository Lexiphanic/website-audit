---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Page not found" description="That page does not exist." path="/404" noindex>
  <main id="main" class="mx-auto w-[min(800px,100%-3rem)] pt-[clamp(8rem,14vw,12rem)] pb-24">
    <p class="eyebrow">404</p>
    <h1 class="mt-4 font-display text-[clamp(2.4rem,6vw,4.2rem)] font-semibold tracking-[-0.03em] text-cream">That page is not here.</h1>
    <p class="mt-4 max-w-[55ch] text-[0.95rem] leading-relaxed text-muted">
      The address may have moved, or the report date may not exist. You can start a fresh audit or go back to the homepage.
    </p>
    <div class="mt-8 flex flex-wrap gap-3">
      <a class="report-button" href="/#audit">Audit a site</a>
      <a class="report-button report-button-ghost" href="/">Home</a>
    </div>
  </main>
</BaseLayout>
