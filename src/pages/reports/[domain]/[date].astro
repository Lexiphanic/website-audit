---
import { domainFromParam } from "../../../lib/audit/normalize";

export const prerender = false;

// The product keeps one report per domain. Old dated links (from the first
// version) permanently redirect to the latest report.
try {
  const domain = domainFromParam(Astro.params.domain ?? "");
  return Astro.redirect(`/reports/${domain}`, 301);
} catch {
  return Astro.redirect("/", 302);
}
---
