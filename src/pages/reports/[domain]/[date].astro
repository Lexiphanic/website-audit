---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import ReportView from "../../../components/ReportView.astro";
import ReportProgress from "../../../components/ReportProgress.astro";
import { loadReportPage } from "../../../lib/report-page";
import { formatDate } from "../../../lib/util";

export const prerender = false;

const data = await loadReportPage(Astro.params.domain ?? "", Astro.params.date ?? "");
const { domain, date, row, payload, dates, error } = data;

Astro.response.headers.set("Referrer-Policy", "no-referrer");
Astro.response.headers.set("X-Robots-Tag", "noindex, nofollow");
if (error || !row) Astro.response.status = 404;

const path = `/reports/${domain}/${date}`;
const latest = dates[0];
---

{error ? (
  <BaseLayout title="Report not found" description="That report date or domain is not valid." path={path} noindex>
    <main id="main" class="mx-auto w-[min(900px,100%-3rem)] pt-[clamp(7rem,12vw,10rem)] pb-24">
      <p class="eyebrow">Not found</p>
      <h1 class="mt-4 font-display text-[clamp(2rem,5vw,3.4rem)] font-semibold text-cream">That report address is not valid.</h1>
      <p class="mt-4 max-w-[60ch] text-[0.95rem] leading-relaxed text-muted">
        Report dates use <span class="text-lilac-100">YYYY-MM-DD</span>. Try the latest report or run a new audit.
      </p>
      <a class="report-button mt-8 inline-flex" href="/#audit">Audit a site</a>
    </main>
  </BaseLayout>
) : !row ? (
  <BaseLayout title={`No report for ${domain} on ${formatDate(date)}`} description={`No audit exists for ${domain} on that date.`} path={path} noindex>
    <main id="main" class="mx-auto w-[min(900px,100%-3rem)] pt-[clamp(7rem,12vw,10rem)] pb-24">
      <p class="eyebrow">No report for that date</p>
      <h1 class="mt-4 font-display text-[clamp(2rem,5vw,3.4rem)] font-semibold text-cream">{domain}</h1>
      <p class="mt-4 max-w-[60ch] text-[0.95rem] leading-relaxed text-muted">
        There is no audit for {formatDate(date)}. {latest ? `The latest report is ${formatDate(latest.report_date)}.` : "Run the first audit for this domain."}
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        {latest && <a class="report-button" href={`/reports/${domain}/${latest.report_date}`}>Latest report</a>}
        <a class="report-button report-button-ghost" href={`/?url=${encodeURIComponent(domain)}#audit`}>Run a new audit</a>
      </div>
    </main>
  </BaseLayout>
) : row.status !== "complete" || !payload ? (
  <BaseLayout title={`Auditing ${domain}`} description={`The audit for ${domain} is running.`} path={path} noindex>
    <main id="main">
      <ReportProgress domain={domain} date={row.report_date} status={row.status} phase={row.phase} progress={row.progress} error={row.error} />
    </main>
  </BaseLayout>
) : (
  <BaseLayout title={`${domain} — ${formatDate(row.report_date)} audit`} description={payload.summary.headline} path={path} noindex>
    <main id="main" class="pt-[clamp(1.5rem,3vw,2.5rem)]">
      <ReportView payload={payload} dates={dates} />
    </main>
  </BaseLayout>
)}
