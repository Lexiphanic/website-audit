---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ReportView from "../../components/ReportView.astro";
import ReportProgress from "../../components/ReportProgress.astro";
import { headlineForScore } from "../../lib/audit/score";
import { loadReportPage } from "../../lib/report-page";

export const prerender = false;

const data = await loadReportPage(Astro.params.domain ?? "");
const { domain, row, payload, error } = data;

Astro.response.headers.set("Referrer-Policy", "no-referrer");
Astro.response.headers.set("X-Robots-Tag", "noindex, nofollow");
if (error || !row) Astro.response.status = 404;

const path = `/reports/${domain}`;
---

{error ? (
  <BaseLayout title={error === "invalid-report" ? "Report unavailable" : "Report not found"} description={error === "invalid-report" ? "This report could not be read." : "That address is not a public domain we can audit."} path={path} noindex>
    <main id="main" class="mx-auto w-[min(900px,100%-3rem)] pt-[clamp(7rem,12vw,10rem)] pb-24">
      <p class="eyebrow">{error === "invalid-report" ? "Report unavailable" : "Not found"}</p>
      <h1 class="mt-4 font-display text-[clamp(2rem,5vw,3.4rem)] font-semibold text-cream">
        {error === "invalid-report" ? "This report could not be read." : "That address does not look like a public domain."}
      </h1>
      <p class="mt-4 max-w-[60ch] text-[0.95rem] leading-relaxed text-muted">
        {error === "invalid-report"
          ? "The stored report is incomplete. Running a fresh audit will replace it."
          : "Enter a domain such as example.com. IP addresses, private hosts and unusual ports are not audited."}
      </p>
      <a class="report-button mt-8 inline-flex" href={error === "invalid-report" ? `/?url=${encodeURIComponent(domain)}#audit` : "/#audit"}>
        {error === "invalid-report" ? "Run a fresh audit" : "Try another site"}
      </a>
    </main>
  </BaseLayout>
) : !row ? (
  <BaseLayout title={`No audit for ${domain}`} description={`No audit has been run for ${domain} yet.`} path={path} noindex>
    <main id="main" class="mx-auto w-[min(900px,100%-3rem)] pt-[clamp(7rem,12vw,10rem)] pb-24">
      <p class="eyebrow">No report yet</p>
      <h1 class="mt-4 font-display text-[clamp(2rem,5vw,3.4rem)] font-semibold text-cream">{domain}</h1>
      <p class="mt-4 max-w-[60ch] text-[0.95rem] leading-relaxed text-muted">
        No audit has been run for this domain. It takes about a minute, and the report is public but noindex.
      </p>
      <a class="report-button mt-8 inline-flex" href={`/?url=${encodeURIComponent(domain)}#audit`}>Audit {domain}</a>
    </main>
  </BaseLayout>
) : row.status !== "complete" || !payload ? (
  <BaseLayout title={`Auditing ${domain}`} description={`The audit for ${domain} is running.`} path={path} noindex>
    <main id="main">
      <ReportProgress domain={domain} status={row.status} phase={row.phase} progress={row.progress} error={row.error} />
    </main>
  </BaseLayout>
) : (
  <BaseLayout title={`${domain} — ${payload.meta.grade} (${payload.meta.score}/100) website audit`} description={`${domain} scored ${payload.meta.grade} (${payload.meta.score}/100) on the Lexiphanic website audit. ${headlineForScore(payload.meta.score)}`} path={path} noindex>
    <main id="main" class="pt-[clamp(1.5rem,3vw,2.5rem)]">
      <ReportView payload={payload} />
    </main>
  </BaseLayout>
)}
