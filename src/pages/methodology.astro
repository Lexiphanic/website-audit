---
import BaseLayout from "../layouts/BaseLayout.astro";
import { CATEGORIES, type CheckDefinition } from "../lib/audit/types";
import { CHECK_DEFINITIONS, checksForCategory } from "../lib/audit/registry";
import { site } from "../lib/site";

const totalChecks = CHECK_DEFINITIONS.length;
const scoredChecks = CHECK_DEFINITIONS.filter((check) => check.weight > 0).length;

function severityTone(severity: CheckDefinition["severity"]): string {
  if (severity === "critical" || severity === "high") return "badge-bad";
  if (severity === "medium") return "badge-warn";
  if (severity === "low") return "badge-info";
  return "badge-muted";
}
---

<BaseLayout
  title="Methodology"
  description={`How Lexiphanic Audit scores a site: ${totalChecks} checks across eight categories, with the evidence, weighting and grade bands explained.`}
  path="/methodology"
>
  <main id="main">
    <section class="relative overflow-hidden pt-[clamp(8rem,14vw,11rem)] pb-[clamp(3rem,6vw,5rem)]">
      <div class="mx-auto w-[min(1000px,100%-3rem)]">
        <p class="eyebrow">Methodology</p>
        <h1 class="mt-4 max-w-[20ch] font-display text-[clamp(2.4rem,6vw,4.2rem)] leading-[1.03] font-semibold tracking-[-0.03em] text-cream">
          A score you can take apart.
        </h1>
        <p class="mt-5 max-w-[68ch] text-[1rem] leading-relaxed text-muted">
          Lexiphanic Audit runs {totalChecks} checks across eight categories. {scoredChecks} of them affect the
          score; the rest are informational, conditional or marked not checked. It is a snapshot of the public
          site as it is today, not a promise about what a rebuild would score. Nothing is hidden behind a
          single number: every finding has the observed value, why it matters and what we would do about it.
        </p>
        <div class="mt-7 flex flex-wrap gap-3 print:hidden">
          <a class="report-button" href="/#audit">Audit a site</a>
          <a class="report-button report-button-ghost" href="/reports/lexiphanic.co.uk">See a real report</a>
        </div>
      </div>
    </section>

    <section class="border-t border-line py-[clamp(2.5rem,5vw,4rem)]">
      <div class="mx-auto grid w-[min(1000px,100%-3rem)] grid-cols-1 gap-6 min-[820px]:grid-cols-2">
        <div class="report-panel">
          <p class="eyebrow">The score</p>
          <p class="mt-3 text-[0.95rem] leading-relaxed text-muted">
            Each scored check contributes its weight. A pass scores 1, a warning 0.5 and a failure 0. The
            category score is the weighted pass rate. The overall score is the weighted average of the eight
            categories, using the category weights below.
          </p>
          <p class="mt-3 text-[0.95rem] leading-relaxed text-muted">
            Informational, not-applicable and not-checked results are excluded, so a missing optional file
            never lowers the grade. The report shows how many scored checks actually ran.
          </p>
        </div>
        <div class="report-panel">
          <p class="eyebrow">Grade bands</p>
          <div class="mt-3 grid grid-cols-3 gap-2 text-[0.86rem] text-muted">
            <span><b class="text-cream">A</b> 90–100</span>
            <span><b class="text-cream">B</b> 80–89</span>
            <span><b class="text-cream">C</b> 70–79</span>
            <span><b class="text-cream">D</b> 60–69</span>
            <span><b class="text-cream">E</b> 50–59</span>
            <span><b class="text-cream">F</b> below 50</span>
          </div>
          <p class="mt-4 text-[0.84rem] leading-relaxed text-muted">
            The letter is a summary, not a certificate. Read the category bars and the findings before making
            a decision.
          </p>
        </div>
      </div>
    </section>

    <section class="border-t border-line py-[clamp(2.5rem,5vw,4rem)]">
      <div class="mx-auto w-[min(1000px,100%-3rem)]">
        <div class="flex flex-wrap items-end justify-between gap-4">
          <div>
            <p class="eyebrow">Categories</p>
            <h2 class="mt-3 font-display text-[clamp(1.8rem,3.5vw,2.6rem)] font-semibold tracking-[-0.02em] text-cream">
              Eight weighted groups.
            </h2>
          </div>
          <p class="max-w-[42ch] text-[0.86rem] leading-relaxed text-muted">
            Jump to a category, or read the full check list below. The weights sum to 100.
          </p>
        </div>
        <div class="mt-6 grid grid-cols-1 gap-3 min-[700px]:grid-cols-2">
          {CATEGORIES.map((category) => (
            <a class="report-panel transition-colors hover:border-violet-500/50" href={`#${category.key}`}>
              <div class="flex items-center justify-between gap-4">
                <h3 class="report-panel-title">{category.label}</h3>
                <span class="text-[0.8rem] font-semibold text-violet-300">{category.weight}%</span>
              </div>
              <p class="mt-2 text-[0.82rem] leading-relaxed text-muted">{category.description}</p>
              <p class="mt-2 text-[0.7rem] text-violet-300">{checksForCategory(category.key).length} checks</p>
            </a>
          ))}
        </div>
      </div>
    </section>

    {CATEGORIES.map((category, index) => (
      <section id={category.key} class="scroll-mt-28 border-t border-line py-[clamp(2.5rem,5vw,4rem)]">
        <div class="mx-auto w-[min(1000px,100%-3rem)]">
          <div class="flex flex-wrap items-end justify-between gap-3 border-b border-line pb-4">
            <div>
              <p class="eyebrow">Category {String(index + 1).padStart(2, "0")}</p>
              <h2 class="mt-2 font-display text-[clamp(1.7rem,3.2vw,2.4rem)] font-semibold tracking-[-0.02em] text-cream">{category.label}</h2>
              <p class="mt-2 max-w-[62ch] text-[0.9rem] leading-relaxed text-muted">{category.description}</p>
            </div>
            <div class="text-right text-[0.82rem] text-muted">
              <p class="font-semibold text-cream">{category.weight}% of the score</p>
              <p class="mt-1">{checksForCategory(category.key).length} checks</p>
            </div>
          </div>

          <div class="mt-5 divide-y divide-[rgba(196,181,253,0.12)]">
            {checksForCategory(category.key).map((check) => (
              <article class="grid gap-2 py-5 min-[760px]:grid-cols-[1fr_2.2fr] min-[760px]:gap-8" id={`check-${check.key}`}>
                <div>
                  <div class="flex flex-wrap items-center gap-2">
                    <span class={`badge ${severityTone(check.severity)}`}>{check.severity}</span>
                    {check.weight === 0 ? (
                      <span class="text-[0.72rem] text-muted">Informational</span>
                    ) : (
                      <span class="text-[0.72rem] text-muted">Weight {check.weight}</span>
                    )}
                  </div>
                  <h3 class="mt-2 text-[1rem] font-medium text-cream">{check.label}</h3>
                </div>
                <div class="grid gap-2 text-[0.86rem] leading-relaxed text-muted">
                  <p>{check.why}</p>
                  <p><span class="font-semibold text-violet-300">The fix:</span> {check.fix}</p>
                </div>
              </article>
            ))}
          </div>
        </div>
      </section>
    ))}

    <section class="border-t border-line py-[clamp(2.5rem,5vw,4rem)]">
      <div class="mx-auto w-[min(1000px,100%-3rem)] rounded-[22px] border border-violet-500/30 bg-[radial-gradient(120%_150%_at_0%_0%,rgba(139,92,246,0.2),transparent_58%),linear-gradient(180deg,rgba(255,255,255,0.04),rgba(255,255,255,0.01))] p-[clamp(1.4rem,3vw,2.3rem)]">
        <p class="eyebrow">Limits</p>
        <h2 class="mt-3 font-display text-[clamp(1.6rem,3vw,2.2rem)] font-semibold text-cream">What this audit is not.</h2>
        <div class="mt-4 grid gap-3 text-[0.9rem] leading-relaxed text-muted min-[760px]:grid-cols-2">
          <p>It fetches public pages and a small file sample. It does not log in, submit forms, crawl the whole site or test for vulnerabilities.</p>
          <p>Lighthouse and field Core Web Vitals are optional. Without a PageSpeed Insights key they are shown as not run, not guessed.</p>
          <p>TLS details come from SSL Labs and the certificate from SSL Labs or crt.sh. A first scan can take a minute.</p>
          <p>HSTS preload status is checked against hstspreload.org; the header alone only requests inclusion.</p>
        </div>
        <p class="mt-5 text-[0.84rem] text-muted">
          Questions about a finding? Email <a class="text-violet-300 underline underline-offset-4" href={`mailto:${site.email}`}>{site.email}</a>.
        </p>
      </div>
    </section>
  </main>
</BaseLayout>
