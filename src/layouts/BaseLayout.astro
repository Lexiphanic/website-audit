---
import "../styles/global.css";
import BaseHead from "../components/layout/BaseHead.astro";
import Ambient from "../components/Ambient.astro";
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";

interface Props {
  title: string;
  description?: string;
  path?: string;
  noindex?: boolean;
  type?: string;
  image?: string;
  bodyClass?: string;
}

const { title, description, path = "/", noindex = false, type, image, bodyClass = "" } = Astro.props;
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <BaseHead title={title} description={description} path={path} noindex={noindex} type={type} image={image} />
  </head>
  <body class={bodyClass}>
    <a class="skip-link" href="#main">Skip to content</a>
    <Ambient />
    <Header />
    <slot />
    <Footer />

    <script>
      const revealables = document.querySelectorAll("[data-reveal]");
      if ("IntersectionObserver" in window) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add("is-visible");
                io.unobserve(entry.target);
              }
            }
          },
          { threshold: 0.15, rootMargin: "0px 0px -60px 0px" },
        );
        revealables.forEach((el) => io.observe(el));
      } else {
        revealables.forEach((el) => el.classList.add("is-visible"));
      }
    </script>
  </body>
</html>
