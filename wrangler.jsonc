{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "client-audit-lexiphanic-co-uk",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-11-03",
  "compatibility_flags": ["nodejs_compat"],
  // Custom domain is attached in the Cloudflare dashboard. Keep the
  // workers.dev and version-preview URLs off so the public surface stays
  // exactly one hostname.
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true
  },
  // The audit is a durable multi-step job. Workflows gives us retries, sleeps
  // and survival past the request that started it; D1 holds the report index.
  "workflows": [
    {
      "name": "audit-workflow",
      "binding": "AUDIT_WORKFLOW",
      "class_name": "AuditWorkflow",
      "default_retention": {
        "success_retention": "1 day",
        "error_retention": "7 days"
      }
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "audit-lexiphanic-co-uk",
      // Replace after `wrangler d1 create audit-lexiphanic-co-uk`.
      "database_id": "a7bb1c74-1d22-41b4-a701-b7a6c481e95d",
      "migrations_dir": "migrations"
    }
  ],
  // Burst protection for the public scan endpoint. Turnstile is the primary
  // bot check; this stops repeated submissions from the same location.
  "ratelimits": [
    {
      "name": "SCAN_RATE",
      "namespace_id": "741003",
      "simple": {
        "limit": 5,
        "period": 60
      }
    }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "none"
  },
  // Workers Previews do not inherit production settings. The preview uses a
  // separate D1 database and Turnstile test keys, and runs the audit inline
  // instead of through the production Workflow.
  "previews": {
    "vars": {
      "APP_ENV": "preview",
      "TURNSTILE_SITE_KEY": "1x00000000000000000000AA",
      "TURNSTILE_HOSTNAMES": "audit.lexiphanic.co.uk"
    },
    "d1_databases": [
      {
        "binding": "DB",
        "database_name": "audit-lexiphanic-co-uk-preview",
        "database_id": "21fd7b2e-2ec3-4f23-9ff8-8581fce1389a",
        "migrations_dir": "migrations"
      }
    ],
    "ratelimits": [
      {
        "name": "SCAN_RATE",
        "namespace_id": "741004",
        "simple": {
          "limit": 5,
          "period": 60
        }
      }
    ]
  },
  "vars": {
    "APP_ENV": "production",
    // Create a Turnstile widget for audit.lexiphanic.co.uk and paste its site
    // key here. With an empty value the form renders without a widget; the API
    // refuses scans in production when TURNSTILE_SECRET is absent.
    "TURNSTILE_SITE_KEY": "0x4AAAAAAFyRdQ4-cYlNpURV",
    "TURNSTILE_HOSTNAMES": "audit.lexiphanic.co.uk"
  }
}
